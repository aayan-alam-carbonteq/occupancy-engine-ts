# Production environment for `docker compose up`. Copy to `.env` NEXT TO
# compose.yaml and fill in. Never commit the filled-in copy -- `.env` and
# `.env.prod` are gitignored; only this template is tracked.
#
# Compose reads `.env` from the directory it runs in AUTOMATICALLY, so no
# --env-file flag is needed as long as the file is named `.env` and sits here.
# Verify what the daemon will actually see, with secrets interpolated, using:
#
#     docker compose config
#
# An unset variable there renders as empty rather than failing, which is why
# both services validate their own inputs at startup instead of trusting compose.

# ---- The partner corpus (required) -----------------------------------------
# Read-only guest role on the partner's Postgres. sslmode=require is not
# optional: the partner's pg_hba rejects non-TLS connections outright.
# If the password contains a URL-reserved character (# ? / @ :), percent-encode
# it or the DSN will parse with a truncated password and fail as an auth error.
PARTNER_DSN=postgresql://USER:PASSWORD@HOST:5432/all_data?sslmode=require

# ---- Engine (required) ------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Every POST /investigate must carry `Authorization: Bearer <this>`. The compose
# default is `dev-engine-token`; leaving that in production publishes an open
# investigation endpoint on :8787. Generate one: `openssl rand -hex 32`
ENGINE_AUTH_TOKEN=

# ---- Tuning (optional; code defaults shown) ---------------------------------
# Per-statement ceiling on the partner DB. 20 s was sized for the assessor scans
# that used to run 19-241 s; those are now ~26 ms through the partial index, so
# this is pure headroom for the slow paths that remain (fetching many rows by
# record_id on records_legacy is still ~195 ms per cold page). Lower it only
# with a measurement in hand.
# PARTNER_STATEMENT_TIMEOUT_MS=20000
# Pool sizing. One container is one uvicorn process by design (see the graph
# service Dockerfile); scale with more containers, not a bigger pool.
# PARTNER_POOL_MIN=1
# PARTNER_POOL_MAX=8
#
# SQL hatch ceilings are deliberately omitted -- they have code defaults in
# service/limits.py derived from measured access paths. Setting them here would
# pin a value that stops tracking the code. See services/graph/.env.example and
# docs/explain-cost-calibration.md before overriding any of them.
